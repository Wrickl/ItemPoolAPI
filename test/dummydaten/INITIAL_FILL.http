  }
}

###
### 6.3 MultipleChoice-Antwort mit Dezimalscore
POST {{baseUrl}}/createSolutionAttempt
Content-Type: application/json

{
  "attempt_id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeee3",
  "candidate_id": "33333333-4444-5555-6666-777777777777",
  "assessment_id": "12345678-1234-1234-1234-123456789abc",
  "item_id": {{itemMultipleChoiceId}},
  "item_version": 1,
  "response": {
    "selected_option_ids": ["a", "b", "d"],
    "auto_score": 0.75
  },
